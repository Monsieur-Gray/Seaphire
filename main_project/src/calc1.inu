_VARS: 3
    int ?a 0
    int ?b 0
    str ?operation ""
EOS!

_MAIN:
    MOV a SINPUT "Enter a:- "
    MOV b SINPUT "Enter b:- "
    MOV operation SINPUT "Enter operation:- (+ - * /)"

    IF [operation == "+"] ADD a b
    ELIF [operation == "-"] SUB a b
    ELIF [operation == "*"] MUL a b
    ELIF [operation == "/"] DIV a b
    ELSE PRINTLN "bhak chutiye, theek se likh"
_END:  