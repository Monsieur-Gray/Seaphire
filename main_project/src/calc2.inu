_VARS: 4
    int ?a 0
    int ?b 0
    str ?oper ""
    str ?retry "yes"
EOS!

_MAIN:

    WHILE [retry == "yes"] {    
        MOV a SINPUT "Enter a:- "
        MOV b SINPUT "Enter b:- "
        MOV oper SINPUT "Enter operation:- (+ - * /)"

        PRINT_COOL a
        PRINT_COOL b

        crap-> So apparantly the entire If-elif-else block is considered one entire line
        IF [oper == "+"] ADD a b
            ELIF [oper == "-"] SUB a b
            ELIF [oper == "*"] MUL a b
            ELIF [oper == "/"] DIV a b
        ELSE PRINTLN "Please select a valid operation"

        MOV retry SINPUT "Do you want to do it again? (yes / no)"
    }
    
    IF [retry != "no"] PRINTLN "You couldve said no "
_END: